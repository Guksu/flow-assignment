{
  "name": "flow-assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose up -d --wait db"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.32.1"
}
