# 로컬 실행: 이 파일을 .env.local로 복사한다. 아래 값은 docker-compose.yml의 로컬 전용 계정이다.
# 배포 값은 Vercel 프로젝트 환경 변수에만 둔다(Neon 풀링 연결 / 직접 연결).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flow

# 마이그레이션용 직접 연결. 비워 두면 DATABASE_URL을 쓴다.
DATABASE_URL_UNPOOLED=

# Vercel Cron 인증용 무작위 값(16자 이상). 로컬에서는 비워도 된다.
CRON_SECRET=
